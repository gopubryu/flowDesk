generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum EventType {
  meeting
  lecture
  trip
  leave
  deadline
  other
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum FinanceCategory {
  sales
  expense
  subscription
}

enum MailFolder {
  inbox
  drafts
  sent
  trash
}

enum PurchaseRequestStatus {
  approval
  unconfirmed
  confirmed
  in_progress
  completed
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks            Task[]
  events           CalendarEvent[]
  finances         FinanceRecord[]
  mails            MailMessage[]
  purchaseRequests PurchaseRequest[]
  purchases        Purchase[]
  salesPlans       SalesPlan[]
  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  slipSequences    SlipSequence[]
  employees        Employee[]
  departments      Department[]
  items            Item[]
  warehouses       Warehouse[]
  vendors          Vendor[]
  quotations       Quotation[]
}

model Employee {
  id           String      @id @default(cuid())
  workspaceId  String
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  name         String
  phone        String?
  email        String?
  memo         String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([departmentId])
}

model Department {
  id          String     @id @default(cuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  memo        String?
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Item {
  id                  String    @id @default(cuid())
  workspaceId         String
  workspace           Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code                String
  name                String
  spec                String?
  unit                String?
  minStock            Float     @default(0)
  inboundPrice        Float     @default(0)
  inboundVatIncluded  Boolean   @default(false)
  outboundPrice       Float     @default(0)
  outboundVatIncluded Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Warehouse {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code        String
  name        String
  memo        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Vendor {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code          String
  name          String
  codeType      String
  bizRegNo      String?
  ceo           String?
  businessType  String?
  businessItem  String?
  phone         String?
  fax           String?
  mobile        String?
  address       String?
  homepage      String?
  contactPerson String?
  email         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?
  assignee    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  startTime   String?
  endTime     String?
  allDay      Boolean   @default(false)
  type        EventType @default(other)
  company     String?
  location    String?
  project     String?
  attendees   String[]  @default([])

  @@index([workspaceId])
}

model FinanceRecord {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      String
  description String
  amount      Float
  status      PaymentStatus   @default(pending)
  date        DateTime
  dueDate     DateTime?
  category    FinanceCategory

  @@index([workspaceId])
}

model MailMessage {
  id             String      @id @default(cuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         MailFolder  @default(inbox)
  from           String
  to             String
  cc             String?
  subject        String
  body           String
  snippet        String?
  starred        Boolean     @default(false)
  read           Boolean     @default(false)
  createdAt      DateTime    @default(now())
  previousFolder MailFolder?

  @@index([workspaceId])
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestDate   DateTime
  slipNo        String?
  vendorCode    String?
  vendorName    String
  managerCode   String?
  managerName   String?
  taxType       String?
  warehouseCode String?
  warehouseName String?
  currency      String?
  dueDate       DateTime?
  status        PurchaseRequestStatus @default(unconfirmed)
  item          String
  quantity      Float                 @default(0)
  amount        Float                 @default(0)
  project       String?
  /// MVP attachments: [{ id, fileName, mimeType, size, dataUrl, createdAt }]
  attachments   Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lines         PurchaseRequestLine[]

  @@index([workspaceId])
  @@index([workspaceId, requestDate])
}

model PurchaseRequestLine {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemCode  String?
  itemName  String
  spec      String?
  qty       Float           @default(0)
  unitPrice Float           @default(0)
  supply    Float           @default(0)
  vat       Float           @default(0)
  total     Float           @default(0)
  extra     String?
  sortOrder Int             @default(0)

  @@index([requestId])
}

enum PurchaseStatus {
  approval
  unconfirmed
  confirmed
}

enum InboundStatus {
  none
  partial
  complete
}

model Purchase {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  purchaseDate      DateTime
  slipNo            String?
  orderNo           String?
  vendorCode        String?
  vendorName        String
  manager           String?
  taxType           String?
  warehouseCode     String?
  warehouseName     String?
  currency          String?
  project           String?
  status            PurchaseStatus @default(unconfirmed)
  /// 미입고 / 부분입고 / 입고완료 — 입고전표 저장 시 갱신
  inboundStatus     InboundStatus  @default(none)
  item              String
  itemCode          String?
  quantity          Float          @default(0)
  amount            Float          @default(0)
  remarks           String?
  sent              Boolean        @default(false)
  accountingReflect Boolean        @default(false)
  printed           Boolean        @default(false)
  importedSlip      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  lines             PurchaseLine[]

  @@index([workspaceId])
  @@index([workspaceId, purchaseDate])
}

model PurchaseLine {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  itemCode   String?
  itemName   String
  spec       String?
  unit       String?
  qty        Float    @default(0)
  unitPrice  Float    @default(0)
  supply     Float    @default(0)
  vat        Float    @default(0)
  total      Float    @default(0)
  extra      String?
  sortOrder  Int      @default(0)

  @@index([purchaseId])
}

enum SalesPlanStatus {
  confirmed
  in_progress
  completed
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired
}

model SalesPlan {
  id                String          @id @default(cuid())
  workspaceId       String
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planDate          DateTime
  slipNo            String?
  vendorCode        String?
  vendorName        String
  item              String
  itemCode          String?
  spec              String?
  quantity          Float           @default(0)
  unitPrice         Float           @default(0)
  amount            Float           @default(0)
  vat               Float           @default(0)
  total             Float           @default(0)
  status            SalesPlanStatus @default(confirmed)
  lastModifier      String?
  closed            Boolean         @default(false)
  /// 미출하 / 부분출하 / 출하완료 (「완료」 flag와 별개)
  outboundStatus    OutboundStatus  @default(none)
  manager           String?
  taxType           String?
  warehouse         String?
  project           String?
  currency          String?
  dueDate           DateTime?
  sourceQuotationId String?         @unique
  sourceQuotation   Quotation?      @relation("QuotationSalesPlan", fields: [sourceQuotationId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lines             SalesPlanLine[]

  @@index([workspaceId])
  @@index([workspaceId, planDate])
}

model Quotation {
  id                   String          @id @default(cuid())
  workspaceId          String
  workspace            Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quoteDate            DateTime
  slipNo               String
  vendorCode           String?
  vendorName           String
  managerCode          String?
  managerName          String?
  validUntil           DateTime?
  status               QuotationStatus @default(draft)
  taxType              String?
  currency             String?
  project              String?
  remarks              String?
  item                 String
  itemCode             String?
  quantity             Float           @default(0)
  amount               Float           @default(0)
  vat                  Float           @default(0)
  total                Float           @default(0)
  convertedSalesPlanId String?         @unique
  convertedAt          DateTime?
  convertedSalesPlan   SalesPlan?      @relation("QuotationSalesPlan")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  lines                QuotationLine[]

  @@unique([workspaceId, slipNo])
  @@index([workspaceId, quoteDate])
  @@index([workspaceId, status])
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemCode    String?
  itemName    String
  spec        String?
  unit        String?
  qty         Float
  unitPrice   Float
  supply      Float
  vat         Float
  total       Float
  extra       String?
  sortOrder   Int       @default(0)

  @@index([quotationId])
}

model SalesPlanLine {
  id        String    @id @default(cuid())
  planId    String
  plan      SalesPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemCode  String?
  itemName  String
  spec      String?
  qty       Float     @default(0)
  unitPrice Float     @default(0)
  supply    Float     @default(0)
  vat       Float     @default(0)
  total     Float     @default(0)
  extra     String?
  sortOrder Int       @default(0)

  @@index([planId])
}

enum OutboundStatus {
  none
  partial
  complete
}

enum StockMovementType {
  receipt
  shipment
  adjustment
}

/// 품목×창고 수불 — 입고(+)/출하(-)/조정(±). 발주·구매확인·판매계획은 재고 미반영.
model StockMovement {
  id            String            @id @default(cuid())
  workspaceId   String
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date          DateTime
  type          StockMovementType
  slipNo        String
  warehouseCode String
  warehouseName String?
  itemCode      String
  itemName      String?
  itemSpec      String?
  itemUnit      String?
  /// 부호 있는 수량: 입고/조정+ = +, 출하/조정- = -
  qty           Float
  relatedType   String?
  relatedId     String?
  memo          String?
  manager       String?
  vendorCode    String?
  vendorName    String?
  createdAt     DateTime          @default(now())

  @@index([workspaceId])
  @@index([workspaceId, date])
  @@index([workspaceId, slipNo])
  @@index([workspaceId, warehouseCode, itemCode])
  @@index([workspaceId, relatedType, relatedId])
  @@index([workspaceId, type])
}

model StockBalance {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseCode String
  warehouseName String?
  itemCode      String
  itemName      String?
  qty           Float     @default(0)
  updatedAt     DateTime  @updatedAt

  @@unique([workspaceId, warehouseCode, itemCode])
  @@index([workspaceId])
  @@index([workspaceId, itemCode])
}

/// Per-workspace, per-day counter used when inventory slips are saved.
/// The unique key makes allocation safe across concurrent requests.
model SlipSequence {
  id          String            @id @default(cuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        StockMovementType
  dateKey     String
  nextNumber  Int               @default(0)
  updatedAt   DateTime          @updatedAt

  @@unique([workspaceId, type, dateKey])
}
