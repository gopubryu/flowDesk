generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum TaskStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum EventType {
  meeting
  lecture
  trip
  leave
  deadline
  other
}

enum PaymentStatus {
  paid
  pending
  overdue
}

enum FinanceCategory {
  sales
  expense
  subscription
}

enum MailFolder {
  inbox
  drafts
  sent
  trash
}

enum PurchaseRequestStatus {
  approval
  unconfirmed
  confirmed
  in_progress
  completed
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks            Task[]
  events           CalendarEvent[]
  finances         FinanceRecord[]
  mails            MailMessage[]
  purchaseRequests PurchaseRequest[]
  salesPlans       SalesPlan[]
}

model Task {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?
  assignee    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
}

model CalendarEvent {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  startTime   String?
  endTime     String?
  allDay      Boolean   @default(false)
  type        EventType @default(other)
  company     String?
  location    String?
  project     String?
  attendees   String[]  @default([])

  @@index([workspaceId])
}

model FinanceRecord {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      String
  description String
  amount      Float
  status      PaymentStatus   @default(pending)
  date        DateTime
  dueDate     DateTime?
  category    FinanceCategory

  @@index([workspaceId])
}

model MailMessage {
  id             String      @id @default(cuid())
  workspaceId    String
  workspace      Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder         MailFolder  @default(inbox)
  from           String
  to             String
  cc             String?
  subject        String
  body           String
  snippet        String?
  starred        Boolean     @default(false)
  read           Boolean     @default(false)
  createdAt      DateTime    @default(now())
  previousFolder MailFolder?

  @@index([workspaceId])
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  workspaceId   String
  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestDate   DateTime
  slipNo        String?
  vendorCode    String?
  vendorName    String
  managerCode   String?
  managerName   String?
  taxType       String?
  warehouseCode String?
  warehouseName String?
  currency      String?
  dueDate       DateTime?
  status        PurchaseRequestStatus @default(unconfirmed)
  item          String
  quantity      Float                 @default(0)
  amount        Float                 @default(0)
  project       String?
  /// MVP attachments: [{ id, fileName, mimeType, size, dataUrl, createdAt }]
  attachments   Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lines         PurchaseRequestLine[]

  @@index([workspaceId])
  @@index([workspaceId, requestDate])
}

model PurchaseRequestLine {
  id        String          @id @default(cuid())
  requestId String
  request   PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  itemCode  String?
  itemName  String
  spec      String?
  qty       Float           @default(0)
  unitPrice Float           @default(0)
  supply    Float           @default(0)
  vat       Float           @default(0)
  total     Float           @default(0)
  extra     String?
  sortOrder Int             @default(0)

  @@index([requestId])
}

enum SalesPlanStatus {
  confirmed
  in_progress
  completed
}

model SalesPlan {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planDate     DateTime
  slipNo       String?
  vendorCode   String?
  vendorName   String
  item         String
  itemCode     String?
  spec         String?
  quantity     Float           @default(0)
  unitPrice    Float           @default(0)
  amount       Float           @default(0)
  vat          Float           @default(0)
  total        Float           @default(0)
  status       SalesPlanStatus @default(confirmed)
  lastModifier String?
  closed       Boolean         @default(false)
  manager      String?
  taxType      String?
  warehouse    String?
  project      String?
  currency     String?
  dueDate      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, planDate])
}

